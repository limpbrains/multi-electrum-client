{
  "name": "multi-electrum-client",
  "version": "0.0.0",
  "description": "Multi-server Electrum (Bitcoin) client for TypeScript with ban-aware routing, partial-batch redirect, subscription restore, and lifecycle support for Node, React Native, browser, and Bun.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "bun": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy/builtins.d.ts",
      "default": "./dist/policy/builtins.js"
    },
    "./cache/memory": {
      "types": "./dist/cache/memory.d.ts",
      "default": "./dist/cache/memory.js"
    },
    "./errors": {
      "types": "./dist/errors/types.d.ts",
      "default": "./dist/errors/types.js"
    },
    "./transport/ws": {
      "types": "./dist/transport/ws.d.ts",
      "default": "./dist/transport/ws.js"
    },
    "./transport/tcp": {
      "types": "./dist/transport/tcp.d.ts",
      "default": "./dist/transport/tcp.js"
    },
    "./transport/tls": {
      "types": "./dist/transport/tls.d.ts",
      "default": "./dist/transport/tls.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run test/unit",
    "test:watch": "vitest test/unit",
    "test:types": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rn": "pnpm test:rn:ios && pnpm test:rn:android",
    "test:rn:setup": "pnpm -C test/rn/app install && pnpm -C test/rn/app pods",
    "test:rn:ios": "pnpm -C test/rn/app harness:ios",
    "test:rn:android": "pnpm -C test/rn/app harness:android",
    "test:rn:integration:ios": "pnpm -C test/rn/app harness:integration:ios",
    "test:rn:integration:android": "pnpm -C test/rn/app harness:integration:android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "pnpm -C examples/demo install && pnpm -C examples/demo dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "fast-check": "^3.0.0",
    "prettier": "^3.0.0",
    "tsd": "^0.31.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.20.0"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "bitcoin",
    "electrum",
    "electrumx",
    "fulcrum",
    "electrs",
    "websocket",
    "react-native"
  ]
}
